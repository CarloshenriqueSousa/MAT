# Dockerfile para o Sandbox de Testes do MAT
# Build com rede: instala todas as ferramentas de análise e teste
# Execução: com --network none para sandbox estrito e seguro

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

# Instala ferramentas essenciais de teste e linting pré-instaladas
RUN pip install --upgrade pip && \
    pip install \
    pytest>=8.3.0 \
    pytest-cov>=5.0.0 \
    pytest-asyncio>=0.24.0 \
    ruff>=0.8.0 \
    coverage>=7.6.0

# Cria usuário não-root seguro
RUN useradd -u 1000 -m -s /bin/bash sandboxuser
USER sandboxuser

CMD ["pytest", "--version"]
