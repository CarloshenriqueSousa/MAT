FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
	PIP_NO_CACHE_DIR=1

RUN apt-get update \
	&& apt-get install --no-install-recommends -y git \
	&& rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir '.[dev]'

WORKDIR /workspace
